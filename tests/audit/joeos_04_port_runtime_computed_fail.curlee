// SPDX-License-Identifier: MIT
//
// JOE OS port-readiness audit — item 4: port I/O to a port number computed at
// RUNTIME from a variable base plus a constant offset.
//
// Mirrors virtio_net.c:
//   outw(io_base + VIRTIO_PCI_QUEUE_SEL, (unsigned short)qsel);   // io_base
//   const unsigned int num = inw(io_base + VIRTIO_PCI_QUEUE_NUM); //   is a
//   outl(io_base + VIRTIO_PCI_QUEUE_PFN, ...);                    //   PCI BAR
// where io_base comes from a PCI BAR probe (runtime-discovered), NOT a
// compile-time constant.
//
// EXPECTED FAILURE: the README documents port I/O as "constant ports only",
// and the parser requires the port argument to be a single integer-literal
// token (IntLiteral or PhysAddrLiteral) — `io_base + 0x0E` is an expression,
// so this should fail at parse time with
//   "port_outw() expects a constant integer port".
// See joeos_04b_port_let_bound.curlee for the "never-reassigned let" probe.

fn main(pm: cap phys.mem) -> U16 {
  unsafe {
    let io_base: Int = 49152;     // runtime-discovered I/O BAR base (0xC000;
                                  // hex only parses in phys/port positions)
    let qsel: Int = 0;            // VIRTIO_PCI_QUEUE_SEL = 0x0E
    port_outw(io_base + 14, qsel);     // outw(io_base + QUEUE_SEL, qsel)
    return port_inw(io_base + 12);     // inw(io_base + QUEUE_NUM)
  }
}
