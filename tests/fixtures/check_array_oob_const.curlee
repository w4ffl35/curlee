// SPDX-License-Identifier: MIT
//
// Issue #278 expected-fail: a constant out-of-bounds index is rejected by the
// type checker on BOTH element reads and element writes (acceptance #2: no
// silent OOB). Expected errors:
//   "array index out of bounds: constant index 8 is not in 0..7 (array length 8)"
//   "array index out of bounds: constant index 8 is not in 0..7 (array length 8)"

fn main() -> Int {
  let q: [Int; 8] = [0; 8];
  q[0] = 42;
  let v: Int = q[8];   // read out of bounds
  q[8] = 7;            // write out of bounds
  return v;
}
