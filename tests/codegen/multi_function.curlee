fn inner(r: Phys<U32>, x: Int, pm: cap phys.mem) -> U32 {
  unsafe {
    let v: U32 = r.read();
    return v;
  }
}

fn outer(r: Phys<U32>, x: Int, pm: cap phys.mem) -> U32 {
  unsafe {
    let y: Int = x + 1;
    return inner(r, y, pm);
  }
}

fn main(pm: cap phys.mem) -> U32 {
  unsafe {
    let reg: Phys<U32> = phys<U32>(0x5000);
    return outer(reg, 10, pm);
  }
}
