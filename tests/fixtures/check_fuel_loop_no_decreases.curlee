// Negative: a `fuel`-annotated function containing a loop WITHOUT a provable
// `decreases` variant must fail closed (the static WCET cannot be bounded).
fn count(n: Int) -> Int
  [ fuel 1000; ]
{
  let i: Int = 0;
  while (i < n) {
    let _dummy: Int = i + 1;
  }
  return i;
}

fn main() -> Int {
  return count(10);
}
