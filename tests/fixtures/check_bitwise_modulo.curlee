// Issue #270: modulo on non-negative operands verifies via the
// division-remainder identity a % b == a - (a / b) * b.
fn mod_identity(a: Int, b: Int) -> Int [
  requires 0 <= a && 0 < b;
  ensures result == a - (a / b) * b;
] {
  return a % b;
}

fn main() -> Int [
  ensures result == 0;
] {
  let r1: Int = mod_identity(17, 5);
  let r2: Int = mod_identity(0, 1);
  let r3: Int = mod_identity(100, 7);
  if (r1 == 2 && r2 == 0 && r3 == 2) {
    return 0;
  } else {
    return 1;
  }
}
