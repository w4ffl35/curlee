// SPDX-License-Identifier: MIT
//
// JOE OS port-readiness audit — item 8b(iii): the mb2.c multiboot2 tag walk
// with a RUNTIME base (issue #279). mb2.c parses the multiboot2 info
// structure GRUB hands the kernel: a list of variable-size tags walked with a
// mutable byte cursor (`p += (size + 7) & ~7U`), starting from a runtime
// physical address (`mb2_info_addr`, captured by the 32-bit boot stub into a
// global at boot time — NOT known at compile time).
//
// Phys<T> addresses must be compile-time literals (probe 8c covers only
// fixed-base reads); the phys_read_u8/u16/u32/u64 builtins accept a general
// Int/U64 address, so the tag walk is expressible with the runtime base plus
// a mutable cursor advanced by assignment (#268). The u64 fb_addr is read as
// two u32 halves (see items 6a/6b); the mb2 gate `bpp == 32 && fb_addr != 0`
// is fully expressible.
//
// Build: ./build/linux-debug/curlee build --link -o build/audit/08d.elf \
//          tests/audit/joeos_08d_mb2_runtime_base.curlee

extern fn curlee_halt() -> Unit;

fn mb2_fb_tag_usable(mb2_info_addr: Int, pm: cap phys.mem) -> Int {
  unsafe {
    // Skip the multiboot2 header (total size at +8, tags from +8 onwards).
    let p: Int = mb2_info_addr + 8;
    let total: U32 = phys_read_u32(p);
    if (total < 8) { return 0; }               // malformed guard

    let guard: Int = 0;
    while (guard < 8)
      [ invariant 0 <= guard && guard <= 8;
        decreases 8 - guard; ]
    {
      let tag_type: U32 = phys_read_u32(p);        // +0 u32 type
      let tag_size: U32 = phys_read_u32(p + 4);    // +4 u32 size
      if (tag_type == 8) {
        // Framebuffer tag: +8 u64 fb_addr, +28 u8 bpp, +29 u8 fb_type.
        let bpp: U8 = phys_read_u8(p + 28);
        let fb_lo: U32 = phys_read_u32(p + 8);
        let fb_hi: U32 = phys_read_u32(p + 12);
        let width: U32 = phys_read_u32(p + 20);
        let height: U32 = phys_read_u32(p + 24);
        if (bpp == 32 && !(fb_lo == 0 && fb_hi == 0)) {
          if (width + 0 == 0 || height + 0 == 0) { return 0; }
          return 1;                                // usable
        }
        return 0;
      }
      // p += (size + 7) & ~7U   (multiboot2 tags are 8-byte aligned)
      let sz: Int = tag_size + 0;              // widen U32 -> Int
      let step: Int = (sz + 7) & ~7;
      p = p + step;
      guard = guard + 1;
    }
    return 0;
  }
}

fn main(pm: cap phys.mem) -> Int {
  // The boot stub would pass the runtime-captured mb2_info_addr here; a
  // fixed probe address (real RAM below 1 MiB) exercises the same code path.
  let r: Int = mb2_fb_tag_usable(0x1_0000, pm);
  curlee_halt();
  return r;
}
